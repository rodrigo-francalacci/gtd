# Neon Postgres connection string (pooled).
# Local dev: copy this file to .env and fill in.
# Vercel: injected automatically by the Neon integration.
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# Google OAuth — see CLAUDE.md for the Cloud console setup.
# Redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only account allowed to sign in. This is the whole authorisation model.
AUTH_ALLOWED_EMAIL=

# Any long random string. Vercel Cron sends it as a Bearer token so the
# sync worker can authorise itself without a session.
CRON_SECRET=
